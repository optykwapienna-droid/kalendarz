# Adres strony (bez ukośnika na końcu), np. https://rezerwacje.optykwapienna.pl
SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API). Klucz service_role trzymaj tylko po stronie serwera.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hasło do panelu /panel oraz sekret do podpisywania sesji (dowolny długi losowy ciąg)
ADMIN_PASSWORD=
SESSION_SECRET=

# Sekret dla zadania cron (Vercel ustawia nagłówek Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# SMS z telefonu gabinetu przez aplikację SMS Gate (Android). Login i hasło
# z zakładki „Home” w aplikacji po włączeniu trybu „Cloud server”.
SMSGATE_USER=
SMSGATE_PASSWORD=
# Zostaw puste dla serwera w chmurze (https://api.sms-gate.app)
SMSGATE_URL=

# Alternatywnie bramka SMSAPI.pl (używana tylko, gdy SMS Gate nie jest ustawiony).
# Bez żadnej konfiguracji SMS-y nie są wysyłane, tylko wypisywane w logach.
SMSAPI_TOKEN=
SMS_SENDER=Test

# Kalendarz Google (konto usługi). Bez tych zmiennych synchronizacja jest wyłączona.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cały klucz z pliku JSON, razem z -----BEGIN PRIVATE KEY----- (znaki \n mogą zostać)
GOOGLE_PRIVATE_KEY=
# Identyfikator kalendarza; dla głównego kalendarza to adres Gmail
GOOGLE_CALENDAR_ID=
