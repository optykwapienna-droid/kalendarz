# Adres strony (bez ukośnika na końcu), np. https://rezerwacje.optykwapienna.pl
SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API). Klucz service_role trzymaj tylko po stronie serwera.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hasło do panelu /panel oraz sekret do podpisywania sesji (dowolny długi losowy ciąg)
ADMIN_PASSWORD=
SESSION_SECRET=

# Sekret dla zadania cron (Vercel ustawia nagłówek Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# SMS przez SMSAPI.pl. Bez tokenu SMS-y nie są wysyłane, tylko wypisywane w logach.
SMSAPI_TOKEN=
SMS_SENDER=Test

# Kalendarz Google (konto usługi). Bez tych zmiennych synchronizacja jest wyłączona.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cały klucz z pliku JSON, razem z -----BEGIN PRIVATE KEY----- (znaki \n mogą zostać)
GOOGLE_PRIVATE_KEY=
# Identyfikator kalendarza; dla głównego kalendarza to adres Gmail
GOOGLE_CALENDAR_ID=
